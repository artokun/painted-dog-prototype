{
  "name": "painted-dog",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "lint:fix": "next lint --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "generate-types": "contentful space export --space-id $CONTENTFUL_SPACE_ID --environment-id $CONTENTFUL_ENVIRONMENT --management-token $CONTENTFUL_MANAGEMENT_TOKEN --export-dir ./contentful-export && cf-content-types-generator contentful-export/contentful-export-*.json -o types -X --response",
    "create-book": "tsx scripts/create-book-in-contentful.ts"
  },
  "dependencies": {
    "@react-spring/three": "^10.0.1",
    "@react-spring/web": "^10.0.1",
    "@react-three/drei": "^10.6.0",
    "@react-three/fiber": "^9.2.0",
    "@react-three/postprocessing": "^3.0.4",
    "@react-three/rapier": "^2.1.0",
    "@types/three": "^0.178.1",
    "clsx": "^2.1.1",
    "contentful": "^11.7.15",
    "dotenv": "^17.2.2",
    "fuse.js": "^7.1.0",
    "leva": "^0.10.0",
    "lucide-react": "^0.536.0",
    "next": "15.4.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "^3.3.1",
    "three": "^0.178.0",
    "three-stdlib": "^2.36.0",
    "use-debounce": "^10.0.5",
    "valtio": "^2.1.5",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cf-content-types-generator": "^2.16.0",
    "contentful-management": "^11.54.4",
    "eslint": "^9.31.0",
    "eslint-config-next": "^15.4.4",
    "prettier": "^3.6.2",
    "tailwindcss": "^4",
    "tsx": "^4.20.5",
    "typescript": "^5"
  }
}
