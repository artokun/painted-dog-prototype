    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cf-content-types-generator": "^2.16.0",
    "contentful-management": "^11.54.4",
    "eslint": "^9.31.0",
    "eslint-config-next": "^15.5.3",
    "prettier": "^3.6.2",
    "tailwindcss": "^4",
    "tsx": "^4.20.5",
    "typescript": "^5"
  }
