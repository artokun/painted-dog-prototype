    "clsx": "2.1.1",
    "contentful": "11.9.0",
    "dompurify": "3.3.2",
    "dotenv": "17.2.3",
    "file-type": "21.3.4",
    "fuse.js": "7.1.0",
    "graphql-request": "7.4.0",
    "gsap": "3.13.0",
