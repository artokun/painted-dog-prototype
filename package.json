{
  "name": "painted-dog",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "lint:fix": "next lint --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "generate-types": "mkdir -p contentful-export && contentful space export --space-id $CONTENTFUL_SPACE_ID --environment-id $CONTENTFUL_ENVIRONMENT --management-token $CONTENTFUL_MANAGEMENT_TOKEN --export-dir ./contentful-export && cf-content-types-generator contentful-export/contentful-export-*.json -o types/generated -X --response && rm -rf contentful-export",
    "create-book": "tsx scripts/create-book-in-contentful.ts"
  },
  "dependencies": {
    "@react-email/render": "^1.3.2",
    "@react-spring/three": "^10.0.1",
    "@react-spring/web": "^10.0.1",
    "@react-three/drei": "file:./lib/drei",
    "@react-three/fiber": "^9.2.0",
    "@react-three/postprocessing": "^3.0.4",
    "@react-three/rapier": "^2.1.0",
    "@types/dompurify": "^3.2.0",
    "@types/hls.js": "^0.13.3",
    "@types/lodash.debounce": "^4.0.9",
    "@types/three": "^0.178.1",
    "@types/validator": "^13.15.3",
    "@use-gesture/react": "^10.3.1",
    "clsx": "^2.1.1",
    "contentful": "^11.7.15",
    "dompurify": "^3.2.7",
    "dotenv": "^17.2.2",
    "file-type": "^21.0.0",
    "fuse.js": "^7.1.0",
    "gsap": "^3.13.0",
    "hls.js": "^1.6.13",
    "leva": "^0.10.0",
    "lodash.debounce": "^4.0.8",
    "lucide-react": "^0.536.0",
    "next": "15.5.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.63.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.1.2",
    "tailwind-merge": "^3.3.1",
    "three": "^0.178.0",
    "three-stdlib": "^2.36.0",
    "use-debounce": "^10.0.5",
    "usehooks-ts": "^3.1.1",
    "validator": "^13.15.15",
    "valtio": "^2.1.5",
    "zod": "^4.0.14"
  },
  "devDependencies": {
